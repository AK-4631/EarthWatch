# EarthWatch environment configuration
# Copy this file to .env and adjust for your deployment.
# Never commit a .env file containing real credentials to version control.

# ---- Application ----
APP_NAME=EarthWatch
APP_VERSION=1.1.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ---- NASA EONET (public API, no key required) ----
# Docs: https://eonet.gsfc.nasa.gov/docs/v3
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
EONET_TIMEOUT_SECONDS=30
EONET_CACHE_TTL_SECONDS=900
EONET_MAX_RETRIES=3
EONET_BACKOFF_FACTOR=1.0

# ---- USGS earthquake feeds (public, no key required) ----
# M2.5+ summary feeds; below-floor magnitudes are a documented scope limit.
USGS_BASE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary
USGS_TIMEOUT_SECONDS=12
USGS_CACHE_TTL_SECONDS=600
USGS_MAX_RETRIES=1
USGS_BACKOFF_FACTOR=0.5

# ---- NOAA National Weather Service active alerts (public, no key) ----
# Scoped to source-graded Extreme/Severe alerts; a descriptive User-Agent is
# sent automatically per NWS API policy.
NWS_BASE_URL=https://api.weather.gov/alerts/active
NWS_TIMEOUT_SECONDS=12
NWS_CACHE_TTL_SECONDS=600
NWS_MAX_RETRIES=1
NWS_BACKOFF_FACTOR=0.5

# ---- NOAA NHC current storms + tsunami bulletins (public, no key) ----
# NHC: https://www.nhc.noaa.gov/CurrentStorms.json
# Tsunami: https://www.tsunami.gov/events/xml/PAAQAtom.xml (bulletin products
# carry publication delay; official guidance always comes from tsunami.gov)
NHC_BASE_URL=https://www.nhc.noaa.gov/CurrentStorms.json
TSUNAMI_BASE_URL=https://www.tsunami.gov/events/xml/PAAQAtom.xml
NOAA_TIMEOUT_SECONDS=12
NOAA_CACHE_TTL_SECONDS=600
NOAA_MAX_RETRIES=1
NOAA_BACKOFF_FACTOR=0.5

# ---- NASA FIRMS (OPTIONAL - server-side credentials only) ----
# Docs: https://firms.modaps.eosdis.nasa.gov/api/
# Obtain an API key from NASA Earthdata and keep it on the server only.
# Never put this value in HTML, JavaScript, or URLs rendered to users.
# FIRMS_API_KEY=your_firms_api_key_here
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/

# ---- NASA GIBS (imagery, no key required for standard access) ----
# Docs: https://www.earthdata.nasa.gov/eosdis/sda/services#gibs
GIBS_BASE_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/
GIBS_DEFAULT_LAYER=MODIS_Terra_CorrectedReflectance_TrueColor
GIBS_CACHE_TTL_SECONDS=86400

# ---- Persistence ----
# SQLite by default. Documented migration path to PostgreSQL/PostGIS exists in README.md.
DATABASE_URL=sqlite:///./earthwatch.db

# ---- Cache ----
CACHE_TTL_DEFAULT_SECONDS=300

# ---- CORS (restrict to known origins in production) ----
CORS_ORIGINS=*

# ---- Rate limiting ----
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
